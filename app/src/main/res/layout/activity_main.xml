<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="@dimen/fc_brand_badge_size"
                android:layout_height="@dimen/fc_brand_badge_size"
                android:background="@drawable/bg_brand_badge">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_film"
                    app:tint="@color/fc_on_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.FrameCut.Display"
                    android:textColor="@color/fc_on_surface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/headerPipelineSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H.265/HEVC · 30 fps · 150 Mbps"
                    android:textAppearance="@style/TextAppearance.FrameCut.Mono"
                    android:textColor="@color/fc_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCropTool"
                android:layout_width="@dimen/fc_min_touch_target"
                android:layout_height="@dimen/fc_min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/crop_tool_title"
                android:src="@drawable/ic_crop"
                app:tint="@color/fc_on_surface" />

            <ImageButton
                android:id="@+id/btnThemeToggle"
                android:layout_width="@dimen/fc_min_touch_target"
                android:layout_height="@dimen/fc_min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle theme"
                android:src="@drawable/ic_theme"
                app:tint="@color/fc_on_surface" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/fc_min_touch_target"
                android:layout_height="@dimen/fc_min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                app:tint="@color/fc_on_surface" />
        </LinearLayout>

        <!-- Scrollable Dashboard -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Recording Console Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/statusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/status_ready"
                                android:textColor="@color/fc_ready_accent"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/metaResolutionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Screen"
                            android:textAppearance="@style/TextAppearance.FrameCut.Mono"
                            android:textColor="@color/fc_on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/timerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="00:00"
                        android:textAppearance="@style/TextAppearance.FrameCut.Timer"
                        android:textColor="@color/fc_on_surface" />

                    <TextView
                        android:id="@+id/consoleSummaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Internal Audio · 150 Mbps · 30 fps"
                        android:textColor="@color/fc_on_surface_variant"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fc_primary_btn_height"
                        android:layout_marginTop="16dp"
                        android:text="@string/action_record"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fc_primary"
                        app:cornerRadius="@dimen/fc_radius_xl"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />

                    <LinearLayout
                        android:id="@+id/activeControlsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPauseResume"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/fc_secondary_btn_height"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/action_pause"
                            android:textAllCaps="false"
                            app:cornerRadius="@dimen/fc_radius_xl"
                            app:icon="@drawable/ic_pause" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStop"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/fc_secondary_btn_height"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/action_stop"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/fc_error"
                            app:cornerRadius="@dimen/fc_radius_xl"
                            app:icon="@drawable/ic_stop" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bannerMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_badge"
                        android:padding="10dp"
                        android:textColor="@color/fc_on_surface"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Recording Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_recording_mode"
                        android:textColor="@color/fc_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileFullScreen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_fullscreen"
                                app:tint="@color/fc_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/mode_full_screen"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/mode_full_screen_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileRegion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_region"
                                app:tint="@color/fc_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/mode_region"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/mode_region_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Selected Region Preview -->
                    <LinearLayout
                        android:id="@+id/cardSelectedRegion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_option_tile_unselected"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <com.aistudio.framecut.region.RegionBorderView
                            android:id="@+id/regionPreviewView"
                            android:layout_width="@dimen/fc_region_preview_width"
                            android:layout_height="112dp"
                            android:background="@color/fc_surface" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_selected_region"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/regionDimensionsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="864 x 1200 px"
                                android:textAppearance="@style/TextAppearance.FrameCut.Mono"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/regionBoundsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/region_gl_note"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAdjustRegion"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:text="@string/action_adjust_region"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                app:cornerRadius="@dimen/fc_radius_md"
                                app:icon="@drawable/ic_tune" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Orientation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_orientation"
                        android:textColor="@color/fc_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tilePortrait"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/orientation_portrait"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/orientation_portrait_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileLandscape"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/orientation_landscape"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/orientation_landscape_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Audio Source -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_audio_source"
                        android:textColor="@color/fc_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileAudioInternal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_volume"
                                app:tint="@color/fc_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/audio_internal"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/audio_internal_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileAudioMic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/fc_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/audio_microphone"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/audio_microphone_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Video Bitrate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_video_bitrate"
                            android:textColor="@color/fc_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bitrateBadgeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150 Mbps"
                            android:textAppearance="@style/TextAppearance.FrameCut.Mono"
                            android:textColor="@color/fc_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipBitrate100"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="100 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBitrate150"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:gravity="center"
                            android:text="150 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBitrate200"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="200 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipBitrate250"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="250 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBitrate300"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="300 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBitrate350"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="350 Mbps"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Custom Bitrate (Mbps)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputCustomBitrate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetBitrate"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/action_reset"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Region Border Animation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_region_animation"
                        android:textColor="@color/fc_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileAnimShow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/fc_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/anim_show"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/anim_show_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileAnimHide"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_tile_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="@color/fc_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/anim_hide"
                                android:textColor="@color/fc_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/anim_hide_sub"
                                android:textColor="@color/fc_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Library & Crop Tool Entrypoints -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenRecordings"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/fc_library_btn_height"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/recorded_videos"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/fc_radius_xl"
                        app:icon="@drawable/ic_library" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenCropTool"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/fc_library_btn_height"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/crop_tool_title"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/fc_radius_xl"
                        app:icon="@drawable/ic_crop" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
